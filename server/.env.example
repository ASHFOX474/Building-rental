PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Neon Serverless PostgreSQL (with ?sslmode=require)
DATABASE_URL=postgres://user:password@ep-example.neon.tech/neondb?sslmode=require

# Admin auth (optional)
ADMIN_PIN_HASH=
JWT_SECRET=change-me

# Google Drive Service Account
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Production cloud env (Render/Railway): paste raw JSON string here
GOOGLE_SERVICE_ACCOUNT_JSON=
# Local development fallback file inside server/
GOOGLE_APPLICATION_CREDENTIALS=./drive-service-account.json
